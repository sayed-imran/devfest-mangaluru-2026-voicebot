# ── Speech-to-text ──────────────────────────────────────────────────────────
# gemma  = Gemma 4 E2B/E4B native audio through LiteRT-LM (laptop default, no extra service)
# whisper = OpenAI-compatible /v1/audio/transcriptions (docker compose, needs a GPU box)
STT_MODE=gemma
STT_LANGUAGE=en

# Used when STT_MODE=gemma. Same server as the chat model.
STT_GEMMA_BASE_URL=http://127.0.0.1:8081
STT_GEMMA_MODEL=gemma4-e4b

# Used when STT_MODE=whisper.
STT_BASE_URL=http://spark-065b:8001
STT_MODEL=openai/whisper-large-v3-turbo

# ── Reasoning (Gemma 4 via LiteRT-LM) ───────────────────────────────────────
# Laptop: ./litert/serve.sh      → http://127.0.0.1:8081, alias gemma4-e4b
# Spark:  see phase-06           → http://spark-065b:8081, alias gemma4-26b
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=gemma4-e4b

# ── Text-to-speech (Kokoro) ─────────────────────────────────────────────────
TTS_BASE_URL=http://127.0.0.1:8880
TTS_VOICE=am_michael
TTS_MODEL=kokoro
TTS_SPEED=1.15
# Heuristic safety net when Laya is offline (server-side).
TTS_MAX_SPEAK_WORDS=45
# How far chat text trails audio (ms). Raise if words still feel early; lower if late.
NEXT_PUBLIC_TTS_REVEAL_LAG_MS=140

# ── Speak vs chat-handoff (Laya, optional) ──────────────────────────────────
# Leave LAYA_BASE_URL empty to skip it; the word-count heuristic above takes over.
LAYA_BASE_URL=http://127.0.0.1:8002
LAYA_TIMEOUT_MS=2500
LAYA_SPEAK_THRESHOLD=0.7

# ── Tools service (tools-service/, FastAPI + MCP) ───────────────────────────
# Actions happen on the computer the tools service runs on.
# Empty TOOLS_BASE_URL = chat only (phase-04 behaviour).
TOOLS_BASE_URL=http://127.0.0.1:8765
# Must match TOOLS_API_KEY in tools-service/.env when it listens beyond localhost.
TOOLS_API_KEY=
TOOLS_TIMEOUT_MS=4000
