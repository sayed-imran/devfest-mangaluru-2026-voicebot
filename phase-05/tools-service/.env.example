# Copy to .env (same folder) and adjust. Real environment variables win over this file.

# Where the tools service listens. Keep 127.0.0.1 when the voicebot app runs on this computer.
TOOLS_HOST=127.0.0.1
TOOLS_PORT=8765
# Required if TOOLS_HOST is not 127.0.0.1 / localhost (use the same value in the app's .env.local).
TOOLS_API_KEY=

# Gemma 4 and Laya run on the DGX Spark. Use its IP if the hostname does not resolve.
LLM_BASE_URL=http://spark-065b.local:8081
LLM_MODEL=gemma4-26b
LAYA_BASE_URL=http://spark-065b.local:8002
LAYA_TIMEOUT_MS=2500
# Laya P(action) needed to treat a turn as a computer action.
TOOLS_ROUTE_THRESHOLD=0.5

# Desktop actions
TOOLS_BROWSER=default             # default | chrome | edge | firefox | brave | safari
TOOLS_SEARCH_ENGINE=google        # google | bing | duckduckgo
TOOLS_MAIL_CLIENT=gmail           # gmail | outlook | outlook-personal | mailto
TOOLS_GMAIL_ACCOUNT=              # optional: which signed-in Gmail account opens drafts
TOOLS_HOME_URL=https://www.google.com/
TOOLS_USER_NAME=                  # used to sign email drafts
TOOLS_DRY_RUN=0                   # 1 = describe actions without opening anything

# Agent
TOOLS_MCP_CONFIG=mcp_servers.json
TOOLS_MAX_STEPS=4
TOOLS_FAST_CONFIRM=1              # speak the tool's own confirmation instead of a second LLM call
