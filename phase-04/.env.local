# Every model runs on the DGX Spark in the room. Nothing is downloaded or run on this laptop.
# If `spark-065b.local` does not resolve on the workshop network, replace it with the Spark's IP
# (the presenter will put it on screen).

# ── Speech-to-text (Whisper large-v3-turbo, vLLM on the Spark) ──────────────
STT_BASE_URL=http://spark-065b.local:8001
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# ── Reasoning (Gemma 4 26B A4B, vLLM on the Spark) ──────────────────────────
LLM_BASE_URL=http://spark-065b.local:8081
LLM_MODEL=gemma4-26b

# ── Text-to-speech (Kokoro on the Spark) ────────────────────────────────────
TTS_BASE_URL=http://spark-065b.local:8880
TTS_VOICE=am_michael
TTS_MODEL=kokoro
TTS_SPEED=1.15
# Heuristic safety net when Laya is offline (server-side).
TTS_MAX_SPEAK_WORDS=45
# How far chat text trails audio (ms). Raise if words still feel early; lower if late.
NEXT_PUBLIC_TTS_REVEAL_LAG_MS=140

# ── Speak vs chat-handoff (Laya on the Spark, optional) ─────────────────────
# Leave LAYA_BASE_URL empty to skip it; the word-count heuristic above takes over.
LAYA_BASE_URL=http://spark-065b.local:8002
LAYA_TIMEOUT_MS=2500
LAYA_SPEAK_THRESHOLD=0.7
