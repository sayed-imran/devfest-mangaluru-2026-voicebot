# Copy to .env on the Spark. docker compose reads it automatically.

# Gemma 4 is gated on Hugging Face: accept the licence on the model page, then paste a read token.
HF_TOKEN=

# vLLM 0.28.0 (arm64), already pulled on the Spark. Has Gemma 4 + the gemma4 tool parser.
VLLM_IMAGE=vllm/vllm-openai:latest
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest

# Set to 1 once every model has downloaded once. From then on the Spark never touches the internet.
HF_HUB_OFFLINE=0

# Gemma tuning. Fractions are of the full 128 GB unified pool.
LLM_HF_MODEL=google/gemma-4-26B-A4B-it
LLM_GPU_MEM=0.55
LLM_MAX_LEN=16384
LLM_MAX_SEQS=48
STT_GPU_MEM=0.10
