# Every model runs on the DGX Spark in the room. Nothing is downloaded or run on this laptop.
# If `spark-065b.local` does not resolve on the workshop network, replace it with the Spark's IP
# (the presenter will put it on screen).

# ── Speech-to-text (Whisper large-v3-turbo, vLLM on the Spark) ──────────────
STT_BASE_URL=http://spark-065b.local:8001
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# ── Reasoning (Gemma 4 26B A4B, vLLM on the Spark) ──────────────────────────
LLM_BASE_URL=http://spark-065b.local:8081
LLM_MODEL=gemma4-26b
