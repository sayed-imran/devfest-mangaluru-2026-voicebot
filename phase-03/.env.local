# ── Speech-to-text ──────────────────────────────────────────────────────────
# gemma  = Gemma 4 E2B/E4B native audio through LiteRT-LM (laptop default, no extra service)
# whisper = OpenAI-compatible /v1/audio/transcriptions (docker compose, needs a GPU box)
STT_MODE=gemma
STT_LANGUAGE=en

# Used when STT_MODE=gemma. Same server as the chat model.
STT_GEMMA_BASE_URL=http://127.0.0.1:8081
STT_GEMMA_MODEL=gemma4-e4b

# Used when STT_MODE=whisper.
STT_BASE_URL=http://spark-065b:8001
STT_MODEL=openai/whisper-large-v3-turbo

# ── Reasoning (Gemma 4 via LiteRT-LM) ───────────────────────────────────────
# Laptop: ./litert/serve.sh      → http://127.0.0.1:8081, alias gemma4-e4b
# Spark:  see phase-06           → http://spark-065b:8081, alias gemma4-26b
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=gemma4-e4b
